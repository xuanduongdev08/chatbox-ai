# ─── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_PRIMARY_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbotpass
POSTGRES_DB=chatbot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+asyncpg://chatbot:chatbotpass@postgres:5432/chatbot_db

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redispass
REDIS_URL=redis://:redispass@redis:6379/0

# ─── Qdrant ─────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=chatbot_documents

# ─── JWT / Security ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Tavily Web Search ───────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# ─── Email / SendGrid ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDGRID_API_KEY=SG.your-sendgrid-key-here
EMAIL_FROM=your-email@gmail.com

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SLIDING_WINDOW_SIZE=20
SUMMARY_TRIGGER_COUNT=40
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
